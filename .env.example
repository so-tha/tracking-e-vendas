# Copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=development
PORT=3333

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://tracking:tracking@localhost:5432/tracking_hub
TEST_DATABASE_URL=postgresql://tracking:tracking@localhost:5432/tracking_hub_test

# Atribuição (ADR-003, ADR-013)
TRACKING_MATCH_WINDOW_HOURS=24

# Conversões: retry (ADR-026)
CONVERSION_MAX_ATTEMPTS=5
CONVERSION_RETRY_BASE_MS=30000

# Fila e worker (ADR-026)
WORKER_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_MS=5000
# Job RUNNING há mais tempo que isto é considerado abandonado e é retomado
JOB_LOCK_TIMEOUT_MS=300000

# Provedores simulados (sem credenciais reais)
PROVIDER_MODE=simulated
# Valores de exercício. Nenhuma credencial real é usada ou necessária.
META_PIXEL_ID=SIMULATED-PIXEL-ID
META_ACCESS_TOKEN=SIMULATED-META-TOKEN
META_API_VERSION=v27.0
GOOGLE_ACCOUNT_ID=1234567890
GOOGLE_CONVERSION_ACTION_ID=9876543210
GOOGLE_ACCESS_TOKEN=SIMULATED-GOOGLE-TOKEN
TIKTOK_PIXEL_CODE=SIMULATEDPIXELCODE
TIKTOK_ACCESS_TOKEN=SIMULATED-TIKTOK-TOKEN
UTMIFY_API_TOKEN=SIMULATED-UTMIFY-TOKEN
UTMIFY_PLATFORM=TrackingHub
# A UTMify exige campos que o webhook não traz. Estes são valores padrão declarados (ADR-037).
UTMIFY_PAYMENT_METHOD=credit_card
UTMIFY_CUSTOMER_NAME=Cliente
REDTRACK_TRACKING_DOMAIN=track.example.com
# Diferencia maiúsculas e precisa existir exatamente assim no RedTrack
REDTRACK_CONVERSION_TYPE=Purchase

# Proteção de /support/* (ADR-024). Formato: operador:segredo,operador:segredo
# Gere segredos longos, por exemplo: openssl rand -hex 32
SUPPORT_API_KEYS=maria:troque-este-segredo-por-um-valor-longo-1,joao:troque-este-segredo-por-um-valor-longo-2
