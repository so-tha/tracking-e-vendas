        {
          "name": "POST /webhooks/orders (evento não suportado, ignorado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "orders"
              ]
            },
            "description": "Registrado com o payload original e ignorado (ignored: true).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"evt_125\",\n  \"event\": \"ORDER_REFUNDED\",\n  \"orderId\": \"ORD-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", function () { pm.response.to.have.status(202); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Suporte",
      "item": [
        {
          "name": "GET /support/orders/:orderId/tracking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/support/orders/{{orderId}}/tracking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support",
                "orders",
                "{{orderId}}",
                "tracking"
              ]
            },
            "description": "Exige X-API-Key. Responde: qual valor foi associado, de onde veio e exatamente o que foi enviado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /support/orders/:orderId/tracking (sem chave, deve dar 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/support/orders/{{orderId}}/tracking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support",
                "orders",
                "{{orderId}}",
                "tracking"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /support/orders/:orderId/reprocess",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/support/orders/{{orderId}}/reprocess",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support",
                "orders",
                "{{orderId}}",
                "reprocess"
              ]
            },
            "description": "Não reenvia o que já foi entregue. O responsável é o operador da chave, nunca um campo do corpo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"includePermanentFailures\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", function () { pm.response.to.have.status(202); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /support/orders/:orderId/reprocess (reiniciar falhas permanentes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/support/orders/{{orderId}}/reprocess",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support",
                "orders",
                "{{orderId}}",
                "reprocess"
              ]
            },
            "description": "Só reinicia falhas que repetir pode resolver. EVENT_TOO_OLD e erros de contrato não são reiniciados.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"includePermanentFailures\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", function () { pm.response.to.have.status(202); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
